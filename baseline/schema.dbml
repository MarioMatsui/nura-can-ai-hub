// =============================================================================
// Nura AI Hub — Database Schema
// =============================================================================
//
// Generated 2026-05-06 from src/integrations/supabase/types.ts (the
// auto-generated Supabase types reflect the current live schema, including
// objects created via the Lovable UI that aren't in the migrations/ folder).
//
// Plus chat_perf_metrics (added in migration 20260505000001 — Phase 0
// instrumentation; not yet reflected in types.ts because types.ts was last
// regenerated before that migration was applied to the live DB).
//
// Render at: https://dbdiagram.io/d (paste this file)
// Or: https://dbml.dbdiagram.io/home (CLI conversion to PNG/PostgreSQL/etc.)
//
// =============================================================================

Project nura_can_ai_hub {
  database_type: 'PostgreSQL'
  Note: '''
    Brazilian PT-BR cannabis-medicinal SaaS.
    Built on Lovable + Supabase + Stripe.
    React 18 frontend, Deno edge functions, Postgres 15+ (with pgvector + pg_trgm).
  '''
}

// =============================================================================
// ENUMS
// =============================================================================

Enum ai_model_type {
  generic
  medical
  legal
  veterinary
  specialist
}

Enum app_role {
  admin
  user
}

Enum billing_cycle_enum {
  mensal
  anual
}

Enum billing_period {
  monthly
  annual
}

Enum cancellation_reason {
  solicitacao_usuario
  upgrade_para_especialista
  outros
}

Enum knowledge_base_type {
  medical
  legal
  veterinary
}

Enum plan_status_enum {
  active
  trialing
  past_due
  canceled
  incomplete
  inactive
}

Enum plan_type_enum {
  free
  medico
  juridico
  veterinario
  especialista
}

Enum subscription_plan {
  free
  medical
  legal
  veterinary
  specialist
}

Enum subscription_status {
  active
  inactive
  cancelled
  scheduled_cancellation
  expired
}

// =============================================================================
// AUTH & USERS
// =============================================================================

// Placeholder for Supabase's auth.users (managed by Supabase Auth, not editable).
Table auth_users {
  id uuid [pk]
  email text
  Note: 'Managed by Supabase Auth. Referenced via profiles.id 1:1 and many user_id FKs.'
}

Table profiles {
  id uuid [pk, ref: - auth_users.id]
  email text [not null]
  full_name text [not null]
  cpf text
  birth_date date
  phone text
  region text
  crm_crv text [Note: 'Medical / Veterinary registration ID']
  profile_completed boolean [not null, default: false]
  receituario_usage_count int [not null, default: 0, Note: 'Free-plan monthly counter for Receituário+']
  receituario_usage_month text [Note: 'YYYY-MM bucket for the counter above']
  terms_accepted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  role app_role [not null]
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// PLANS & BILLING
// =============================================================================

Table user_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  plan_type plan_type_enum [not null]
  status plan_status_enum [not null]
  billing_cycle billing_cycle_enum
  current_period_end timestamptz
  cancel_at_period_end boolean [not null, default: false]
  stripe_customer_id text
  subscription_id text
  raw json [Note: 'Raw Stripe webhook payload at last update']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Active plan-per-user table used by Dashboard. Latest source-of-truth for entitlements.'
}

Table user_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  plan_type subscription_plan [not null]
  status subscription_status [not null]
  billing_period billing_period
  started_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  cancel_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Older subscriptions table. Coexists with user_plans (legacy / parallel tracking).'
}

Table subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  plan_type plan_type_enum [not null]
  status plan_status_enum [not null]
  event text [not null, Note: 'Stripe event name that triggered this row']
  effective_at timestamptz [not null, default: `now()`]
  metadata json
  created_at timestamptz [not null, default: `now()`]
  Note: 'Append-only subscription event log (audit trail).'
}

Table cancellation_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  subscription_id uuid [not null, ref: > user_subscriptions.id]
  plan_code text [not null]
  plan_type_requested subscription_plan
  cancellation_reason cancellation_reason
  reason text
  notes text
  status text [not null, default: 'pending']
  provider text [not null, Note: 'e.g. stripe']
  provider_subscription_id text
  effective_cancel_at timestamptz [not null]
  processed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  amount numeric [not null]
  status text [not null]
  plan_type subscription_plan [not null]
  billing_cycle billing_period
  provider text [not null]
  provider_payment_id text
  charge_id text
  payer_email text
  reference text
  request_id text
  payload_raw json
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table plan_settings {
  id uuid [pk, default: `gen_random_uuid()`]
  plan_code text [not null, unique]
  display_name text [not null]
  display_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Admin-controlled per-plan UI/availability config.'
}

// =============================================================================
// CHAT
// =============================================================================

Table conversations {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  title text [not null]
  model_type ai_model_type [not null, default: 'generic']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table messages {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null, ref: > conversations.id]
  role text [not null, Note: "'user' or 'assistant'"]
  content text [not null]
  attachments json [Note: 'Array of {file_path, file_name, file_type, storage_url}']
  created_at timestamptz [not null, default: `now()`]
}

Table ai_usage {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  conversation_id uuid [ref: > conversations.id]
  model text [not null]
  tokens_input int [not null, default: 0]
  tokens_output int [not null, default: 0]
  cost numeric [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Per-request token + cost log. Used for AdminFinance dashboard.'
}

// =============================================================================
// CHAT PERFORMANCE METRICS (Option 1 — Phase 0)
// =============================================================================

Table chat_perf_metrics {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [ref: > conversations.id]
  user_id uuid [ref: > auth_users.id]
  model text
  model_type text
  knowledge_type text
  t_request_start timestamptz [not null]
  duration_total_ms int
  duration_auth_ms int
  duration_rag_ms int
  duration_llm_ms int
  duration_ttft_ms int [Note: 'Time-to-first-token (Phase 1+)']
  duration_response_ms int
  rag_chunk_count int [default: 0]
  attachment_count int [default: 0]
  tokens_input int [default: 0]
  tokens_output int [default: 0]
  status_code int
  error text
  created_at timestamptz [not null, default: `now()`]
  Note: 'Per-request perf tracking. Populated by chat-ai edge function (fire-and-forget). Admin-readable via has_role(...).'
}

// =============================================================================
// KNOWLEDGE BASE (RAG source)
// =============================================================================

Table knowledge_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  title text [not null]
  file_name text [not null]
  file_path text
  file_size_bytes bigint
  file_hash text
  knowledge_type knowledge_base_type [not null]
  doc_type text
  language text
  author text
  content text [not null]
  metadata json
  extracted_metadata json
  total_pages int
  status text [not null, default: 'pending']
  progress int
  error_message text
  created_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table document_chunks {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null, ref: > knowledge_documents.id]
  chunk_order int [not null, Note: 'Renamed from chunk_index outside the migrations folder']
  content text [not null]
  embedding text [Note: 'pgvector(1536) — populated, but unused by current chat-ai (uses ILIKE instead). Strong Option 2 candidate.']
  block_ids text[]
  chunk_type text
  is_atomic boolean
  page_range text
  hash text
  created_at timestamptz [not null, default: `now()`]
}

Table document_blocks {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null, ref: > knowledge_documents.id]
  block_id text [not null]
  block_type text [not null]
  content text [not null]
  markdown text
  embedding text [Note: 'pgvector embedding']
  page_number int [not null]
  section_title text
  bbox json [Note: 'Bounding-box on the source PDF page']
  token_count int
  created_at timestamptz [not null, default: `now()`]
  Note: 'Created via Lovable UI — not in migrations/ folder.'
}

Table document_tables {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null, ref: > knowledge_documents.id]
  table_id text [not null]
  markdown text [not null]
  structured_data json [not null]
  caption text
  embedding text
  page_number int [not null]
  bbox json
  created_at timestamptz [not null, default: `now()`]
  Note: 'Extracted tabular data from PDFs. Created via Lovable UI.'
}

Table document_images {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null, ref: > knowledge_documents.id]
  image_id text [not null]
  storage_path text [not null]
  thumbnail_path text
  caption text
  description text
  ocr_text text
  image_type text
  page_number int [not null]
  bbox json
  created_at timestamptz [not null, default: `now()`]
  Note: 'Storage in document-images bucket. Created via Lovable UI.'
}

Table processing_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null, ref: > knowledge_documents.id]
  job_type text [not null]
  status text [not null, default: 'pending']
  progress int
  started_at timestamptz
  completed_at timestamptz
  error_message text
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// RECEITUÁRIO+ (Prescription generation)
// =============================================================================

Table prescription_catalogs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  file_name text [not null]
  file_path text [not null]
  file_type text [not null]
  file_size bigint
  extracted_content text
  extracted_metadata json
  created_at timestamptz [not null, default: `now()`]
  Note: 'PDF catalogs of available cannabis products uploaded by the user.'
}

Table prescription_records {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  file_name text [not null]
  file_path text [not null]
  file_type text [not null]
  file_size bigint
  patient_name text
  main_complaint text
  extracted_content text
  extracted_metadata json
  created_at timestamptz [not null, default: `now()`]
  Note: 'Patient medical records uploaded for prescription generation.'
}

Table prescription_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  catalog_id uuid [not null, ref: > prescription_catalogs.id]
  record_id uuid [not null, ref: > prescription_records.id]
  result_id uuid [ref: > prescription_results.id]
  status text [not null, default: 'pending']
  progress text
  observations text
  ai_response text
  error_message text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Async prescription generation jobs (LLM workflow).'
}

Table prescription_results {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  catalog_id uuid [ref: > prescription_catalogs.id]
  record_id uuid [ref: > prescription_records.id]
  patient_name text
  main_complaint text
  user_observations text
  ai_response text [not null]
  suggested_products json
  model_used text
  pinned_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table saved_catalogs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > auth_users.id]
  catalog_id uuid [not null, ref: > prescription_catalogs.id]
  display_name text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'User-pinned catalogs for reuse across prescription jobs.'
}

// =============================================================================
// CONTENT (Blog)
// =============================================================================

Table blog_posts {
  id uuid [pk, default: `gen_random_uuid()`]
  author_id uuid [ref: > auth_users.id]
  slug text [not null, unique]
  title text [not null]
  content text [not null, default: '']
  excerpt text
  cover_image_url text
  status text [not null, default: 'draft']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// OPERATIONS / AUDIT / WEBHOOKS
// =============================================================================

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  admin_user_id uuid [not null, ref: > auth_users.id]
  action text [not null]
  table_name text [not null]
  record_id uuid [not null]
  old_values json
  new_values json
  timestamp timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Trail of admin actions on profiles (and other sensitive tables).'
}

Table admin_notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  type text [not null]
  payload json [not null, default: `'{}'::jsonb`]
  status text [not null, default: 'pending']
  read_at timestamptz
  processed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table webhook_events {
  id uuid [pk, default: `gen_random_uuid()`]
  provider text [not null, default: 'stripe']
  event_type text [not null]
  event_id text
  external_reference text
  charge_id text
  payer_email text
  reference text
  request_id text
  status text
  payload json [not null]
  valid_token boolean
  processed boolean [default: false]
  processed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'Raw inbound Stripe webhooks (and similar) for replay/idempotency.'
}

Table processed_webhooks {
  id uuid [pk, default: `gen_random_uuid()`]
  webhook_id text [not null, unique]
  event_type text [not null]
  processed_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Idempotency lock — prevents double-processing of webhook deliveries.'
}

Table financial_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  amount numeric [not null]
  type text [not null]
  tag text [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
  Note: 'Manual finance ledger surface for AdminFinance dashboard.'
}

Table app_settings {
  key text [pk]
  value json [not null]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Generic kv store for runtime feature flags and admin-tunable knobs.'
}

// =============================================================================
// TABLE GROUPS (helps dbdiagram.io render clusters)
// =============================================================================

TableGroup users_and_auth {
  auth_users
  profiles
  user_roles
}

TableGroup plans_and_billing {
  user_plans
  user_subscriptions
  subscriptions
  cancellation_requests
  payments
  plan_settings
}

TableGroup chat {
  conversations
  messages
  ai_usage
  chat_perf_metrics
}

TableGroup knowledge_base {
  knowledge_documents
  document_chunks
  document_blocks
  document_tables
  document_images
  processing_jobs
}

TableGroup receituario {
  prescription_catalogs
  prescription_records
  prescription_jobs
  prescription_results
  saved_catalogs
}

TableGroup content {
  blog_posts
}

TableGroup ops {
  audit_logs
  admin_notifications
  webhook_events
  processed_webhooks
  financial_transactions
  app_settings
}
